{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug_code",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "module": "main",
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",
            },


            // test cifar
            "args": [
                "--method", "flyprompt",
                "--dataset", "cifar100",
                "--data_dir", "./_002n_data/CIFAR",
                "--backbone", "vit_base_patch16_224_mepo_21k_1k",
                
                "--n_tasks", "5",
                "--n", "50",
                "--m", "10",

                "--batchsize", "64",
                "--lr", "0.005",

                "--online_iter", "3",
                "--num_epochs", "1",

                "--use_amp",

                "--eval_period", "1000",

                "--note", "flyprompt_cifar100",
            ],




            // "justMyCode": false,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
    ]
}